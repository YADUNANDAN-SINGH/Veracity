# Copy to .env (git-ignored), fill in, and start the backend with:
#   uvicorn main:app --reload --port 8000 --env-file .env
# Setup steps for every PayPal value: docs/PAYPAL_SETUP.md

# --- PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section. Optional: without it, payment
# statuses come from PayPal's API answers only, and /api/paypal/webhook is off.
PAYPAL_WEBHOOK_ID=
# 1 = after a release, forward the money to the recipient's PayPal email with
# Payouts (turn on Payouts for the sandbox app first). 0 = capture only.
PAYPAL_PAYOUTS=0

# --- Where the user lives: IN (1930, cybercrime.gov.in, Chakshu) or US (FTC, IC3) ---
VERA_REGION=IN
VERA_CURRENCY=USD

# --- Hold policy for Protected Send ---
# Holds are voided after this many hours (72 at most: PayPal's honor period is 3 days)
VERA_HOLD_HOURS=72
# A high-risk payment waits this long after the callback before it is released
VERA_COOL_OFF_MIN=15

# --- No phone handy? Replay a sample call through the real rules ---
# VERA_FAKE=1
# VERA_SCENARIO=grandparent_us
