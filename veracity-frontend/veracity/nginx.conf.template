# Serves the built dashboard and forwards API + WebSocket traffic to FastAPI.
# ${BACKEND_URL} is filled in from the environment when the container starts.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's internal DNS. Resolving at request time (via the variable below)
    # lets nginx start even if the backend container isn't up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend ${BACKEND_URL};

    # REST: /api/health, /api/number/analyze, /api/session/...
    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Live call events: /ws/live/{session_id}
    location /ws/ {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s; # a call can last a long time
    }

    # Hashed build assets never change, so cache them hard
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths fall back to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
