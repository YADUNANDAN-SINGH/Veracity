# For the full judge build: cp .env.example .env (git-ignored), fill in, then
#   docker compose --profile judge up --build judge
# Everything here is optional. Without PayPal keys the app still runs and
# Protected Send says PayPal isn't set up. Setup steps: docs/PAYPAL_SETUP.md

# PayPal SANDBOX app (developer.paypal.com → Apps & Credentials → Sandbox). Never live keys.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A sandbox personal (buyer) account to log in to the PayPal pop-up with; the first screen shows it
VERA_SANDBOX_BUYER_EMAIL=
VERA_SANDBOX_BUYER_PASSWORD=

# Optional tuning (the image's defaults are shown)
# VERA_UPLOAD_SPEED=1        2 plays an uploaded recording twice as fast
# VERA_WHISPER_THREADS=      CPU threads for Whisper (default: up to 8)
